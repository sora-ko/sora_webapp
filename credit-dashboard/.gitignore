.venv/
.pytest_cache/
__pycache__/
*.py[cod]

# CSVは原則として無視し、確認済みの架空サンプル3点だけを共有する。
*.[cC][sS][vV]
!/examples/first-year-sample.csv
!/examples/graduation-sample.csv
!/examples/graduation-sample-original-format.csv

# 学生データや生成キャッシュは共有しない。起動用の公開カタログだけを許可する。
/data/*
!/data/recommendations/
/data/recommendations/*
!/data/recommendations/2026/
/data/recommendations/2026/*
!/data/recommendations/2026/liberal-catalog.json
!/data/recommendations/2026/README.md

# 旧手渡しZIPはローカルに保持する。初回起動には不要。
/handoff/

# Windowsからコピーしたファイルのダウンロード元情報。
*:Zone.Identifier
