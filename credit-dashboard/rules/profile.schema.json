{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/academic-rule-profile-v1.json",
  "title": "Academic rule profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "scope",
    "source_documents",
    "classification",
    "requirements",
    "open_questions"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "mvp_policy": {
      "type": "object",
      "required": ["decided_on", "notes"],
      "properties": {
        "decided_on": {"type": "string", "format": "date"},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["institution", "faculty", "program", "admission_year"],
      "properties": {
        "institution": {"type": "string", "minLength": 1},
        "faculty": {"type": "string", "minLength": 1},
        "program": {"type": "string", "minLength": 1},
        "admission_year": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "official", "verified_on", "page_numbering_note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "official": {"type": "boolean"},
          "verified_on": {"type": "string", "format": "date"},
          "page_numbering_note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "classification": {
      "type": "object",
      "required": ["faculty_specialized_prefixes"],
      "properties": {
        "course_catalog_path": {"type": "string", "minLength": 1},
        "outside_catalog_policy": {"const": "liberal_elective"},
        "excluded_course_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "faculty_specialized_prefixes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "course_name_ignored_suffixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "course_name_aliases": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "requirements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "evidence_status",
          "source_refs",
          "blocking_open_question_ids",
          "conditions",
          "allocation_rules"
        ],
        "properties": {
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["minimum_residence_years", "minimum_credits", "minimum_credits_from_named_courses", "minimum_residual_credits", "shared_surplus_minimum", "required_courses"]},
                "selector": {"type": "object"},
                "minimum": {"type": "number", "minimum": 0}
              },
              "if": {"properties": {"kind": {"const": "required_courses"}}},
              "then": {"required": ["selector"]},
              "else": {"required": ["minimum"]}
            }
          }
        }
      }
    },
    "open_questions": {"type": "array"}
  },
  "additionalProperties": false
}
